{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GGG Timer",
  "version": "0.1.5",
  "identifier": "com.godgamergauntlet.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GGG Timer",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
